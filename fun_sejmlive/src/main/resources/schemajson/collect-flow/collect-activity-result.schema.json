{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onlexnet.dev/sejmstream/collect-flow/collect-activity-result.schema.json",
  "title": "CollectActivityResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "count"
  ],
  "properties": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "termNum": {
      "type": "integer",
      "minimum": 0
    },
    "collectionDate": {
      "type": "string",
      "format": "date"
    },
    "itemKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interpellationFingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}