{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onlexnet.dev/sejmstream/collect-flow/collect-orchestrator-event-v1.schema.json",
  "title": "CollectOrchestratorEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orchestrationInstanceId",
    "source",
    "termNum",
    "collectionDate",
    "countsByType"
  ],
  "properties": {
    "orchestrationInstanceId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "termNum": {
      "type": "integer",
      "minimum": 1
    },
    "collectionDate": {
      "type": "string",
      "format": "date"
    },
    "countsByType": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}