# For Terraform Cloud, set these values as workspace variables or via TF_VAR_* environment variables.
# Configure Azure authentication separately in the workspace with ARM_* environment variables.
# ARM_SUBSCRIPTION_ID is part of provider authentication and is not a Terraform input variable.

# For Terraform Cloud, set these values as workspace variables or via TF_VAR_* environment variables.
# Configure Azure authentication separately in the workspace with ARM_* environment variables.
# ARM_SUBSCRIPTION_ID is part of provider authentication and is not a Terraform input variable.

spring_datasource_url      = null  # e.g. jdbc:postgresql://<neon-host>/<db>?sslmode=require
spring_datasource_username = null
spring_datasource_password = null
facebook_token             = null

# GitHub App authentication (recommended; no PAT required)
github_owner              = "onlexnet"
github_repo               = "sejmstream"
github_app_id             = "<github-app-id>"
github_app_installation_id = "<github-app-installation-id>"
github_app_pem_file       = "<github-app-private-key-pem>"
github_environments = {
  prod = {}
}

tags = {
  owner = "team-sejmstream"
}
