{
  "name": "sejmstream",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "app",
  "workspaceFolder": "/sejmstream",
  
  // https://containers.dev/features
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/devcontainers/features/java:1": { }
  },

  "forwardPorts": [
    8080,
    5432
  ],
  "remoteEnv": {
    "AZURE_SUBSCRIPTION_NAME": "${localEnv:AZURE_SUBSCRIPTION_NAME}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "eamodio.gitlens",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "vmware.vscode-boot-dev-pack",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "databricks.neon-local-connect"
      ],
      "settings": {
        "java.configuration.detectJdksAtStart": true,
        "spring-boot.ls.java.home": "/usr/local/sdkman/candidates/java/current"
      }
    }
  },
  // why: named volumes may be recreated as root-owned, which breaks tools that need write access
  "postStartCommand": "mkdir -p /home/worker/.ssh /home/worker/.terraform.d && sudo chown -R worker:worker /home/worker/.ssh /home/worker/.terraform.d && chmod 700 /home/worker/.ssh /home/worker/.terraform.d && command -v mvn >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y maven) && bash /sejmstream/.devcontainer/scripts/azure-init.sh",
  "remoteUser": "worker"
}