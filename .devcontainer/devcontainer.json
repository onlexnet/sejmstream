{
  "name": "sejmstream",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "app",
  "workspaceFolder": "/sejmstream",
  
  // https://containers.dev/features
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/copilot-cli:1.1.3": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/terraform:1.4.3": {},
    "ghcr.io/devcontainers/features/java:1": {
      "installGroovy": false,
      "installAnt": false,
      "installGradle": false,
      "installMaven": true,
      "version": "21", "jdkDistro": "librca" 
    }
  },

  "forwardPorts": [
    8080,
    5432
  ],
  "remoteEnv": {
    "AZURE_SUBSCRIPTION_NAME": "${localEnv:AZURE_SUBSCRIPTION_NAME}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "eamodio.gitlens",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "vmware.vscode-boot-dev-pack",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "databricks.neon-local-connect",
        "ms-vscode.vscode-chat-customizations-evaluations"
      ],
      "settings": {
        "java.configuration.detectJdksAtStart": true,
        "spring-boot.ls.java.home": "/usr/local/sdkman/candidates/java/current"
      }
    }
  },
  // why: named volumes may be recreated as root-owned, which breaks tools that need write access
  "postStartCommand": "bash /sejmstream/.devcontainer/scripts/post-start.sh",
  "remoteUser": "worker"
}